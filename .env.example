# Copy to .env (never commit .env) and export before running:  set -a; source .env; set +a
# All values below are PLACEHOLDERS.

DB_URL=jdbc:mysql://localhost:3306/attendance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=attendance_app
DB_PASSWORD=CHANGE_ME_db_password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_random_string_of_32_plus_chars
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# First administrator (created on first start only if the password is set, min 8 chars)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Optional demo data for local demonstrations
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=CHANGE_ME_demo_password

ATTENDANCE_EDIT_WINDOW_DAYS=7
ATTENDANCE_LOW_THRESHOLD=75
SWAGGER_ENABLED=true
